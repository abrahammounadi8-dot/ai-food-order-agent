<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />

  <title>AI Food Order Agent</title>

  <style>
    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      font-family: Arial, Helvetica, sans-serif;
      background:
        radial-gradient(circle at top, #202020 0%, #111111 45%, #070707 100%);
      color: white;
      min-height: 100vh;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 750px;
      background: rgba(20, 20, 20, 0.95);
      border: 1px solid #303030;
      border-radius: 24px;
      padding: 40px;
      box-shadow: 0 25px 70px rgba(0, 0, 0, 0.5);
    }

    .badge {
      display: inline-block;
      padding: 8px 14px;
      border-radius: 999px;
      background: #252525;
      color: #b5b5b5;
      font-size: 13px;
      margin-bottom: 20px;
    }

    h1 {
      font-size: clamp(36px, 8vw, 64px);
      line-height: 1;
      margin-bottom: 18px;
    }

    h1 span {
      color: #ff7a00;
    }

    .subtitle {
      color: #aaa;
      font-size: 18px;
      line-height: 1.6;
      margin-bottom: 30px;
    }

    .order-box {
      background: #111;
      border: 1px solid #333;
      border-radius: 18px;
      padding: 20px;
    }

    textarea {
      width: 100%;
      min-height: 150px;
      resize: vertical;
      border: none;
      outline: none;
      background: transparent;
      color: white;
      font-size: 17px;
      line-height: 1.5;
    }

    textarea::placeholder {
      color: #666;
    }

    button {
      width: 100%;
      margin-top: 16px;
      padding: 16px;
      border: none;
      border-radius: 14px;
      background: #ff7a00;
      color: white;
      font-size: 17px;
      font-weight: bold;
      cursor: pointer;
      transition: 0.2s ease;
    }

    button:hover {
      transform: translateY(-2px);
      opacity: 0.92;
    }

    button:disabled {
      cursor: not-allowed;
      opacity: 0.65;
      transform: none;
    }

    #response {
      margin-top: 20px;
      padding: 18px;
      border-radius: 14px;
      background: #171717;
      border: 1px solid #2c2c2c;
      color: #ddd;
      display: none;
      line-height: 1.6;
    }

    .examples {
      margin-top: 25px;
      color: #777;
      font-size: 14px;
      line-height: 1.8;
    }

    .examples strong {
      color: #aaa;
    }

    .footer {
      margin-top: 30px;
      text-align: center;
      color: #555;
      font-size: 13px;
    }

    @media (max-width: 600px) {
      .container {
        padding: 25px;
      }

      h1 {
        font-size: 42px;
      }
    }
  </style>
</head>

<body>

  <main class="container">

    <div class="badge">
      🍔 AI-powered ordering
    </div>

    <h1>
      AI Food <span>Order Agent</span>
    </h1>

    <p class="subtitle">
      Tell the AI what you want to eat in normal language.
      The agent will understand your order and help prepare it.
    </p>

    <div class="order-box">

      <textarea
        id="order"
        placeholder="Example: I want a large chicken burger meal with fries and a Coke..."
      ></textarea>

      <button id="submitBtn" onclick="createOrder()">
        Ask AI Agent
      </button>

    </div>

    <div id="response"></div>

    <div class="examples">
      <strong>Try saying:</strong><br>
      “Find me a halal chicken burger meal under €20.”<br>
      “I want pizza for two people.”<br>
      “Order me something healthy with chicken.”
    </div>

    <div class="footer">
      AI Food Order Agent • MVP
    </div>

  </main>

  <script>
    function escapeHtml(text) {
      return text
        .replace(/&/g, "&amp;")
        .replace(/</g, "&lt;")
        .replace(/>/g, "&gt;")
        .replace(/"/g, "&quot;")
        .replace(/'/g, "&#039;");
    }

    async function createOrder() {
      const orderInput = document.getElementById("order");
      const response = document.getElementById("response");
      const submitBtn = document.getElementById("submitBtn");
      const order = orderInput.value.trim();

      if (!order) {
        response.style.display = "block";
        response.innerHTML = "🍽️ Tell me what you would like to eat first.";
        return;
      }

      submitBtn.disabled = true;
      submitBtn.textContent = "Thinking...";
      response.style.display = "block";
      response.innerHTML = "⏳ Processing your order with AI...";

      try {
        const result = await fetch("/api/order", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ order })
        });

        const data = await result.json();

        if (!result.ok) {
          throw new Error(data.error || "Failed to process order.");
        }

        response.innerHTML = `
          <strong>🤖 AI Agent response:</strong>
          <br><br>
          ${escapeHtml(data.reply).replace(/\n/g, "<br>")}
        `;
      } catch (error) {
        response.innerHTML = `❌ ${escapeHtml(error.message || "Unknown error.")}`;
      } finally {
        submitBtn.disabled = false;
        submitBtn.textContent = "Ask AI Agent";
      }
    }
  </script>

</body>
</html>